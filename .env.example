APP_NAME="Sistema Hospitalar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Use Neon's direct endpoint (without -pooler) for this custom schema.
DB_CONNECTION=pgsql
DB_URL="postgresql://ROLE:PASSWORD@DIRECT_ENDPOINT.neon.tech/DATABASE?sslmode=require"
DB_SCHEMA=thiago_sistemahospitalar_bd
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
